# Virtual environment
.venv/
__pycache__/
*.pyc

# Dataset — fetched from Hugging Face at build time via
# scripts/download_dataset.py, never committed to the repo.
data/*.csv
data/*.parquet
!data/manual_examples.csv

# Trained model — derived directly from the dataset above, so it's kept out
# for the same reason. Reproduce it locally: download_dataset.py then
# train_classifier.py (see README).
models/*.joblib

# HF cache
.cache/

# Env
.env
